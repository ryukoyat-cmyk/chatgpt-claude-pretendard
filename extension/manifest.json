{
  "manifest_version": 3,
  "name": "ChatGPT Noto Sans KR Auto",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "description": "ChatGPT에 Noto Sans KR을 자동 적용하고 설정을 유지합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}